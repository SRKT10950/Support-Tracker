# Copy to a deployment secret store or local .env; never commit populated values.
PORT=9010
HOST_PORT=9010
DB_API_KEY=
DB_DEVICE_SECURITY_KEY=
# Public egress IP of the Coolify host as seen by the database API.
DB_CLIENT_IP=
DB_DEVICE_NAME=SRKT-Laptop
DB_LOCATION=
DB_DEVICE_TYPE=Desktop
DB_APP_NAME=Support Tracker
# Set once to bootstrap the first PostgreSQL administrator (minimum 12 characters).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Set true only when public requests are forced through Coolify's trusted proxy.
TRUST_PROXY=false
